# ===== 研墨 AI · 服务端配置示例 =====
# 复制本文件为 .env.local 后填写；.env.local 不会被提交到 Git。
# 也可以不配置这里，直接在网页的「设置」页填写 Key（浏览器本地保存，优先级更高）。

# OpenAI 兼容接口的 API Key
AI_API_KEY=

# 接口地址，注意保留服务商要求的版本路径（/v1、/v4 等）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型。手写识别要求该模型支持图片输入
AI_MODEL=qwen-vl-max-latest

# 可选：把识别与批改拆成两个模型
# AI_VISION_MODEL=qwen-vl-max-latest
# AI_TEXT_MODEL=qwen-plus

# 可选：默认开启 JSON 模式；如果服务商不支持 response_format，设为 false
# AI_JSON_MODE=true
