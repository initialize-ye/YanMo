{
  "name": "yanmo-ai",
  "version": "0.2.0",
  "private": true,
  "description": "考研英语手写作文批改工具",
  "author": "YanMo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "electron:dev": "electron .",
    "build:exe": "npm run build && npm run prepare:standalone && electron-builder --win portable --config electron-builder.yml",
    "build:exe:dir": "npm run build && npm run prepare:standalone && electron-builder --win --dir --config electron-builder.yml"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
