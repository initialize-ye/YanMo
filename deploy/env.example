# 复制为 /srv/yanmo/app/.env.production 并填写（chmod 600，属主 yanmo）
# 不要把本文件提交真实密钥。

# ---- 服务端 AI 配置（启用后访客无需自带 Key）----
# 需选择支持图片输入（vision）的模型，OCR / 题目识别依赖它
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini
# 可选：自定义 OpenAI 兼容网关
# AI_BASE_URL=https://api.openai.com/v1

# ---- 访问控制说明 ----
# 若只想自己使用、防止他人消耗你的 Key，用 Nginx Basic Auth 保护 /api/ 即可
# （见 deploy/README.md「保护 AI Key」一节），无需改动应用代码。

# ---- 云备份存储目录（服务端只存密文）----
YANMO_DATA_DIR=/srv/yanmo/data

# ---- 站点地址（用于生成 latest.json 与下载链接）----
YANMO_PUBLIC_URL=https://your-domain.example.com
